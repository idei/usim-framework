    /**
     * Mapeo de nombres de componentes visuales a atributos limpios de backend:
     * -------------------------------------------------------------------------
     * ¿Para qué sirve?
     * En tus Screens, los componentes visuales suelen nombrarse 'input_name' o
     * 'select_role_id'. Con este mapa defines un alias limpio ('name', 'role_id')
     * para usar en tus reglas de validación y en tus propiedades DTO.
     *
     * Además, si la validación falla en 'name', USIM enlaza automáticamente el
     * mensaje de error al componente visual 'input_name' en la pantalla del usuario.
     *
     * @var array<string, string>
     */
    protected array $map = [
