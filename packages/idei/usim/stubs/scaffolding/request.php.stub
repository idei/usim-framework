    /**
     * Autorización de la solicitud:
     * -------------------------------------------------------------------------
     * ¿Para qué sirve?
     * Determina si el usuario autenticado tiene permisos para ejecutar esta acción.
     * Si retorna `false`, USIM detiene la ejecución inmediatamente y devuelve un
     * error HTTP 403 (Forbidden).
     *
     * Ejemplos:
     * - return auth()->check() && auth()->user()->can('manage-users');
     * - return $this->screen?->canAccess() ?? true;
     */
    public function authorize(): bool
    {
        return true;
    }

    /**
     * Sanitización y normalización previa a la validación:
     * -------------------------------------------------------------------------
     * ¿Para qué sirve?
     * Permite limpiar espacios (trim), forzar mayúsculas/minúsculas, eliminar
     * caracteres no deseados o asignar valores predeterminados antes de que se
     * evalúen las reglas de validación.
     *
     * Ejemplo:
     * $this->merge([
     *     'name'  => trim((string) $this->input('name')),
     *     'email' => strtolower(trim((string) $this->input('email'))),
     * ]);
     */
