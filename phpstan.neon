includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/
        - packages/
    level: 9
    excludePaths:
        - database/migrations/*_create_permission_tables.php

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: packages/idei/usim/config/usim.php
